# Supabase Storage image uploads
# Copy these values into .env.local and into Vercel Project Settings > Environment Variables.

IMAGE_UPLOAD_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=webtatuajes-images
SUPABASE_QUOTE_STORAGE_BUCKET=webtatuajes-quote-images
SUPABASE_UPLOAD_FOLDER=webtatuajes
SUPABASE_SIGNED_URL_TTL_SECONDS=300
