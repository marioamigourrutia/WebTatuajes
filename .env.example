NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public quote submissions do not require Firebase email-link verification.
NEXT_PUBLIC_STUDIO_NAME=HuespedTattooStudio
NEXT_PUBLIC_ARTIST_NAME=Mario Amigo Urrutia
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# Spark/free mode default: public quote references are sent through a private contact channel, not uploaded.
NEXT_PUBLIC_QUOTE_FILE_UPLOADS_ENABLED=false
# Local emulator opt-in. Keep disabled unless running Firebase emulators locally.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_ENABLED=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Server-side project id for local emulators and split Firebase Admin credentials.
FIREBASE_PROJECT_ID=demo-webtatuajes
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Server-only Firebase Admin credentials. Use either JSON or the complete split set;
# incomplete or placeholder credentials are invalid. Do not commit real credentials.
FIREBASE_SERVICE_ACCOUNT_JSON={}
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRST_ADMIN_UID=
FIRST_ADMIN_EMAIL=
FIREBASE_ADMIN_CONFIRM_ASSIGNMENT=
# Public contact channels. These values are safe to expose because visitors need them to contact the studio.
NEXT_PUBLIC_WHATSAPP_PHONE=+56977616917
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola HuespedTattooStudio, quiero consultar por un tatuaje.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_APP_LOCALE=es-CL
NEXT_PUBLIC_APP_TIME_ZONE=America/Santiago
# External image uploads. Keep disabled for URL-only/manual image management unless a supported provider is already configured.
IMAGE_UPLOAD_PROVIDER=disabled
IMAGE_UPLOAD_MAX_SIZE_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=webtatuajes
# Instagram official API, server-only. Leave empty until Meta app, permissions and tokens exist.
# Do not use browser tokens, scraping cookies or NEXT_PUBLIC_ for these values.
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Baseline per-instance in-memory rate limits. For production at scale, replace/enforce with Vercel Firewall, Upstash/KV, Redis or another shared edge/backend control.
RATE_LIMIT_DEFAULT_LIMIT=20
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_QUOTES_LIMIT=20
RATE_LIMIT_QUOTES_WINDOW_MS=60000
RATE_LIMIT_QUOTES_STATUS_LIMIT=12
RATE_LIMIT_QUOTES_STATUS_WINDOW_MS=60000
RATE_LIMIT_PURCHASE_REQUESTS_LIMIT=20
RATE_LIMIT_PURCHASE_REQUESTS_WINDOW_MS=60000
RATE_LIMIT_REVIEWS_LIMIT=20
RATE_LIMIT_REVIEWS_WINDOW_MS=60000
RATE_LIMIT_COMMUNITY_MEMBERS_LIMIT=20
RATE_LIMIT_COMMUNITY_MEMBERS_WINDOW_MS=60000
RATE_LIMIT_COMMUNITY_MEMBERS_UNSUBSCRIBE_LIMIT=20
RATE_LIMIT_COMMUNITY_MEMBERS_UNSUBSCRIBE_WINDOW_MS=60000

# CSP allowlist extensions for real production domains not covered by the defaults.
CSP_CONNECT_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
