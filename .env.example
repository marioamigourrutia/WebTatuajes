NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase email-link sign-in uses NEXT_PUBLIC_SITE_URL/quote as the action URL.
# Add this domain/action URL to Firebase Auth authorized domains before production use.
NEXT_PUBLIC_STUDIO_NAME=HuespedTattooStudio
NEXT_PUBLIC_ARTIST_NAME=Mario Amigo Urrutia
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# Spark/free mode default: image uploads require an external provider, not Firebase Storage.
NEXT_PUBLIC_QUOTE_FILE_UPLOADS_ENABLED=false
# Local emulator opt-in. Keep disabled unless running Firebase emulators locally.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_ENABLED=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-webtatuajes
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Existing .env.local files must include this for Admin Storage to read local quote images.
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Server-only Firebase Admin placeholder. Do not commit real credentials.
FIREBASE_SERVICE_ACCOUNT_JSON={}
# First-admin assignment script inputs. Keep unset unless running the controlled server-only script.
FIRST_ADMIN_UID=
FIRST_ADMIN_EMAIL=
FIREBASE_ADMIN_CONFIRM_ASSIGNMENT=
NEXT_PUBLIC_WHATSAPP_PHONE=+56977616917
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola HuespedTattooStudio, quiero consultar por un tatuaje.
NEXT_PUBLIC_APP_LOCALE=es-CL
NEXT_PUBLIC_APP_TIME_ZONE=America/Santiago
# External image uploads. Supabase Storage is server-only; never expose the service role key with NEXT_PUBLIC_.
IMAGE_UPLOAD_PROVIDER=disabled
IMAGE_UPLOAD_MAX_SIZE_BYTES=5242880
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=webtatuajes-images
# Optional private bucket for quote/client reference images. Defaults to SUPABASE_STORAGE_BUCKET.
SUPABASE_QUOTE_STORAGE_BUCKET=
# Short-lived admin preview URLs for private quote images, in seconds.
SUPABASE_SIGNED_URL_TTL_SECONDS=300
SUPABASE_UPLOAD_FOLDER=webtatuajes
# Legacy Cloudinary compatibility. Prefer Supabase Storage for new deployments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=webtatuajes
