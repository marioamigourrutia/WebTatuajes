rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function currentProfile() {
      return get(profilePath(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && currentProfile().data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isArtist() {
      return hasRole('artist');
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function quotePath(quoteId) {
      return /databases/$(database)/documents/quotes/$(quoteId);
    }

    function quoteData(quoteId) {
      return get(quotePath(quoteId)).data;
    }

    function isQuoteCustomer(quoteId) {
      return signedIn()
        && exists(quotePath(quoteId))
        && quoteData(quoteId).customer_id == request.auth.uid;
    }

    function isAssignedToQuote(quoteId) {
      return signedIn()
        && exists(quotePath(quoteId))
        && quoteData(quoteId).artist_id == request.auth.uid;
    }

    function hasOnlyAllowedKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changedOnlyAllowedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validStatus(status, allowed) {
      return status is string && status in allowed;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['full_name', 'phone', 'role', 'created_at', 'updated_at'])
        && data.full_name is string
        && optionalString(data, 'phone')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at')
        && (!('role' in data) || validStatus(data.role, ['customer', 'artist', 'admin']));
    }

    function validQuote(data) {
      return data.keys().hasOnly([
          'customer_id',
          'artist_id',
          'status',
          'body_area',
          'size_description',
          'style',
          'description',
          'budget_clp',
          'admin_notes',
          'created_at',
          'updated_at'
        ])
        && data.customer_id is string
        && validStatus(data.status, ['pending', 'contacted', 'closed', 'spam'])
        && optionalString(data, 'artist_id')
        && optionalString(data, 'body_area')
        && optionalString(data, 'size_description')
        && optionalString(data, 'style')
        && optionalString(data, 'description')
        && optionalNumber(data, 'budget_clp')
        && optionalString(data, 'admin_notes')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validQuoteImage(data) {
      return data.keys().hasOnly([
          'customer_id',
          'quote_id',
          'storage_path',
          'mime_type',
          'size_bytes',
          'created_at',
          'updated_at'
        ])
        && data.customer_id is string
        && data.quote_id is string
        && data.storage_path is string
        && data.mime_type in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']
        && data.size_bytes is int
        && data.size_bytes > 0
        && data.size_bytes <= 10 * 1024 * 1024
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at')
        && exists(quotePath(data.quote_id))
        && quoteData(data.quote_id).customer_id == data.customer_id
        && data.storage_path.matches('quote-images/' + data.customer_id + '/' + data.quote_id + '/[^/]+');
    }

    function quoteHasNoArtist(quoteId) {
      return !('artist_id' in quoteData(quoteId));
    }

    function quoteArtistMatches(quoteId, artistId) {
      return quoteHasNoArtist(quoteId) || quoteData(quoteId).artist_id == artistId;
    }

    function validAppointment(data) {
      return data.keys().hasOnly([
          'customer_id',
          'artist_id',
          'quote_id',
          'status',
          'scheduled_start_at',
          'scheduled_end_at',
          'notes',
          'admin_notes',
          'created_at',
          'updated_at'
        ])
        && data.customer_id is string
        && data.artist_id is string
        && data.quote_id is string
        && validStatus(data.status, ['scheduled', 'completed', 'cancelled', 'rescheduled'])
        && optionalTimestamp(data, 'scheduled_start_at')
        && optionalTimestamp(data, 'scheduled_end_at')
        && optionalString(data, 'notes')
        && optionalString(data, 'admin_notes')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at')
        && exists(quotePath(data.quote_id))
        && quoteData(data.quote_id).customer_id == data.customer_id
        && quoteArtistMatches(data.quote_id, data.artist_id);
    }

    function validArtist(data) {
      return data.keys().hasOnly(['profile_id', 'display_name', 'bio', 'avatar_path', 'published', 'created_at', 'updated_at'])
        && data.profile_id is string
        && optionalString(data, 'display_name')
        && optionalString(data, 'bio')
        && optionalString(data, 'avatar_path')
        && optionalBool(data, 'published')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validPortfolioItem(data) {
      return data.keys().hasOnly(['artist_id', 'title', 'description', 'image_path', 'published', 'created_at', 'updated_at'])
        && data.artist_id is string
        && optionalString(data, 'title')
        && optionalString(data, 'description')
        && optionalString(data, 'image_path')
        && optionalBool(data, 'published')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validProduct(data) {
      return data.keys().hasOnly(['title', 'description', 'price_clp', 'image_path', 'active', 'created_at', 'updated_at'])
        && optionalString(data, 'title')
        && optionalString(data, 'description')
        && optionalNumber(data, 'price_clp')
        && optionalString(data, 'image_path')
        && optionalBool(data, 'active')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validSponsor(data) {
      return data.keys().hasOnly(['name', 'description', 'logo_path', 'website_url', 'active', 'created_at', 'updated_at'])
        && optionalString(data, 'name')
        && optionalString(data, 'description')
        && optionalString(data, 'logo_path')
        && optionalString(data, 'website_url')
        && optionalBool(data, 'active')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validReview(data) {
      return data.keys().hasOnly(['customer_id', 'artist_id', 'rating', 'comment', 'approved', 'created_at', 'updated_at'])
        && optionalString(data, 'customer_id')
        && optionalString(data, 'artist_id')
        && optionalNumber(data, 'rating')
        && optionalString(data, 'comment')
        && optionalBool(data, 'approved')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validCommunityPost(data) {
      return data.keys().hasOnly(['title', 'body', 'author_id', 'published', 'created_at', 'updated_at'])
        && optionalString(data, 'title')
        && optionalString(data, 'body')
        && optionalString(data, 'author_id')
        && optionalBool(data, 'published')
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    function validContactLead(data) {
      return data.keys().hasOnly(['full_name', 'email', 'phone', 'message', 'status', 'created_at', 'updated_at'])
        && data.keys().hasAny(['full_name', 'email', 'phone', 'message'])
        && optionalString(data, 'full_name')
        && optionalString(data, 'email')
        && optionalString(data, 'phone')
        && optionalString(data, 'message')
        && (!('status' in data) || validStatus(data.status, ['new', 'reviewing', 'closed']))
        && optionalTimestamp(data, 'created_at')
        && optionalTimestamp(data, 'updated_at');
    }

    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && !('role' in request.resource.data);
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && changedOnlyAllowedKeys(['full_name', 'phone', 'updated_at']);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && validProfile(request.resource.data);
    }

    match /quotes/{quoteId} {
      allow get: if (signedIn() && resource.data.customer_id == request.auth.uid)
        || isAdmin()
        || (isArtist() && resource.data.artist_id == request.auth.uid);
      allow list: if false;
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow get: if isAdmin()
          || (isArtist() && isAssignedToQuote(quoteId))
          || (isQuoteCustomer(quoteId) && resource.data.customer_visible == true);
        allow list: if false;
        allow write: if isAdmin() || (isArtist() && isAssignedToQuote(quoteId));
      }
    }

    match /quote_images/{imageId} {
      allow get: if (signedIn() && resource.data.customer_id == request.auth.uid)
        || isAdmin()
        || (isArtist() && isAssignedToQuote(resource.data.quote_id));
      allow list: if false;
      allow create: if signedIn()
        && validQuoteImage(request.resource.data)
        && request.resource.data.customer_id == request.auth.uid
        && isQuoteCustomer(request.resource.data.quote_id);
      allow update: if (isAdmin() && validQuoteImage(request.resource.data))
        || (signedIn()
          && validQuoteImage(request.resource.data)
          && resource.data.customer_id == request.auth.uid
          && request.resource.data.customer_id == resource.data.customer_id
          && request.resource.data.quote_id == resource.data.quote_id
          && request.resource.data.storage_path == resource.data.storage_path
          && changedOnlyAllowedKeys(['mime_type', 'size_bytes', 'updated_at']));
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow get: if (signedIn() && resource.data.customer_id == request.auth.uid)
        || isAdmin()
        || (isArtist() && resource.data.artist_id == request.auth.uid);
      allow list: if false;
      allow create: if (isAdmin() && validAppointment(request.resource.data))
        || (isArtist()
          && validAppointment(request.resource.data)
          && request.resource.data.artist_id == request.auth.uid
          && !('admin_notes' in request.resource.data));
      allow update: if (isAdmin() && validAppointment(request.resource.data))
        || (isArtist()
          && validAppointment(request.resource.data)
          && resource.data.artist_id == request.auth.uid
          && request.resource.data.customer_id == resource.data.customer_id
          && request.resource.data.quote_id == resource.data.quote_id
          && request.resource.data.artist_id == resource.data.artist_id
          && !('admin_notes' in request.resource.data));
      allow delete: if isAdmin() || (isArtist() && resource.data.artist_id == request.auth.uid);
    }

    match /artists/{artistId} {
      allow get: if resource.data.published == true || isAdmin() || (isArtist() && isOwner(resource.data.profile_id));
      allow list: if false;
      allow create: if validArtist(request.resource.data)
        && (isAdmin() || (isArtist() && isOwner(request.resource.data.profile_id)));
      allow update: if (isAdmin() && validArtist(request.resource.data))
        || (isArtist()
          && isOwner(resource.data.profile_id)
          && validArtist(request.resource.data)
          && request.resource.data.profile_id == resource.data.profile_id);
      allow delete: if isAdmin() || (isArtist() && isOwner(resource.data.profile_id));
    }

    match /portfolio_items/{itemId} {
      allow get: if resource.data.published == true || isAdmin() || (isArtist() && isOwner(resource.data.artist_id));
      allow list: if false;
      allow create: if validPortfolioItem(request.resource.data)
        && (isAdmin() || (isArtist() && isOwner(request.resource.data.artist_id)));
      allow update: if (isAdmin() && validPortfolioItem(request.resource.data))
        || (isArtist()
          && isOwner(resource.data.artist_id)
          && validPortfolioItem(request.resource.data)
          && request.resource.data.artist_id == resource.data.artist_id);
      allow delete: if isAdmin() || (isArtist() && isOwner(resource.data.artist_id));
    }

    match /products/{productId} {
      allow get: if resource.data.active == true || isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow get: if resource.data.active == true || isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validSponsor(request.resource.data);
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if resource.data.approved == true || isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validReview(request.resource.data);
      allow delete: if isAdmin();
    }

    match /community_posts/{postId} {
      allow get: if resource.data.published == true || isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validCommunityPost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /contact_leads/{leadId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validContactLead(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
