{
  "name": "webtatuajes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-webtatuajes --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:existing": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-webtatuajes vitest run --config vitest.rules.config.ts",
    "emulators": "firebase emulators:start --project demo-webtatuajes --only auth,firestore,storage",
    "dev:local": "npm run dev",
    "admin:assign-first-admin": "node scripts/assign-first-admin.mjs",
    "admin:seed-local": "node --env-file=.env.local scripts/seed-local-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "next": "16.3.6",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "latest",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.20.0",
    "jsdom": "latest",
    "prettier": "^3.8.4",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  }
}
